@page "/cutCalculator"

<PageTitle>Cut Calulator</PageTitle>

<body>

    <header>
        <h1>Cut Calulator</h1>
    </header>

    <main>
        @if (Running)
        {
            <div class="loading-overlay">
                <h2>Running Solver...</h2>
            </div>
        }
        else
        {
            <div class="panel">
                <div class="tools">
                    <div class="tool">
                        <label>Height</label>
                        <input id="height" type="number" min="300" @bind="Sheet.Height" />
                    </div>
                    <div class="tool">
                        <label>Width</label>
                        <input id="width" type="number" min="300" @bind="Sheet.Width" />
                    </div>
                </div>
            </div>

            <br />

            <div class="panel">
                <table>
                    <thead>
                        <tr>
                            <td>Height</td>
                            <td>Width</td>
                            <td>Quantity</td>
                            <td></td>
                        </tr>
                    </thead>

                    @foreach (Piece item in Pieces)
                    {
                        <tr>
                            <td>
                                <input type="number" min="50" @bind="item.Height" />
                            </td>
                            <td>
                                <input type="number" min="50" @bind="item.Width" />
                            </td>
                            <td>
                                <input type="number" min="1" @bind="item.Quantity" />
                            </td>
                            <td>
                                <button class="btn btn-danger" @onclick="() => RemoveItem(item)">Remove</button>
                            </td>
                        </tr>
                    }

                    <tr class="newrow">
                        <td>
                            <input type="number" min="50" @bind="AddPiece.Height" />
                        </td>
                        <td>
                            <input type="number" min="50" @bind="AddPiece.Width" />
                        </td>
                        <td>
                            <input type="number" min="1" @bind="AddPiece.Quantity" />
                        </td>
                        <td>
                            <button class="btn btn-primary" @onclick="AddItem">Add</button>
                        </td>
                    </tr>

                </table>

            </div>

            <br />

            <button class="btn btn-primary" @onclick="Solve">Cut</button>

            <br />

            @if (InfoMessage != "")
            {
                <h2>@InfoMessage</h2>
                <br />
            }

            @if (Solutions.Select(x => x.Value.Count()).Sum() == Pieces.Select(x => x.Quantity).Sum() & Solutions.Any())
            {
                <div class="result">
                    <div class="svg-tabs">
                        <div class="tab-buttons">
                            @for (int i = 0; i < Output.Count; i++)
                            {
                                int index = i;

                                <button class="@(ActiveTab == index ? "active" : "")" @onclick="() => ActiveTab = index">
                                    Sheet @(index + 1)
                                </button>
                            }
                        </div>


                        <div id="myNav" class="overlay">
                            <a href="javascript:void(0)" class="closebtn" onclick="closeNav()">&times;</a>
                            <div class="overlay-content">
                                @(Output[ActiveTab])
                            </div>
                        </div>

                        <div class="svg-container">
                            <span style="font-size:48px;cursor:pointer" onclick="openNav()">&#43;</span>
                            @(Output[ActiveTab])
                        </div>
                    </div>
                </div>
            }

            <script>
                function openNav() {
                    document.getElementById("myNav").style.display = "block";
                }

                function closeNav() {
                    document.getElementById("myNav").style.display = "none";
                }
            </script>

        }


    </main>
</body>
